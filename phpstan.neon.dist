includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - config
        # The shipped conformance trait is analysed through the classes that use it.
        - tests/Conformance
        # bin/vector-bench logic (7.7).
        - tests/Support/BenchDataset.php
        - tests/Support/BenchReport.php
        - tests/Support/BenchRunner.php
        - tests/Support/RetrievalMetrics.php
    configDirectories:
        - config
    scanFiles:
        - stubs/agenticgraph-tracing.stub.php
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    ignoreErrors:
        # The three managers take the container like Laravel's own managers (Illuminate\Support\Manager). Larastan
        # 3.13 started matching arrow functions here; Octane support is not verified yet (open item, B11 session C).
        -
            identifier: larastan.octaneCompatibility
            path: src/VectorServiceProvider.php
            count: 3
    checkModelProperties: true

    checkMissingCallableSignature: true
    checkPhpDocMissingReturn: true
    checkPhpDocMethodSignatures: true
    reportMaybesInMethodSignatures: true
    reportStaticMethodSignatures: true
    checkMissingVarTagTypehint: true
